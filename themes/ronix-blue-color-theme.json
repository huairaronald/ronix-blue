  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#64748b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation and JSDoc",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "storage.type.class.jsdoc",
        "punctuation.definition.bracket.curly.jsdoc"
      ],
      "settings": {
        "foreground": "#64748b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags and annotations",
      "scope": [
        "entity.name.tag.documentation",
        "storage.type.class.documentation",
        "comment.block.documentation keyword",
        "comment.block.documentation storage"
      ],
      "settings": {
        "foreground": "#38bdf8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Flow Control",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.trycatch",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#38bdf8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage Types & Modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.typeof",
        "keyword.operator.instanceof",
        "keyword.operator.sizeof"
      ],
      "settings": {
        "foreground": "#7dd3fc"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison",
        "keyword.operator.bitwise",
        "keyword.operator.relational",
        "keyword.operator.ternary"
      ],
      "settings": {
        "foreground": "#93c5fd"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "variable.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#67e8f9"
      }
    },
    {
      "name": "Function Calls",
      "scope": [
        "meta.function-call.generic",
        "support.function.builtin",
        "support.function.console"
      ],
      "settings": {
        "foreground": "#60a5fa"
      }
    },
    {
      "name": "Classes, Structs & Interfaces",
      "scope": [
        "entity.name.type.class",
        "entity.name.class",
        "entity.name.type.interface",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "support.class",
        "support.interface"
      ],
      "settings": {
        "foreground": "#2dd4bf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types & Typedefs",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.type.primitive",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#2dd4bf"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#f1f5f9"
      }
    },
    {
      "name": "Variable Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#fdba74"
      }
    },
    {
      "name": "Object Properties & Member Variables",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.property.object"
      ],
      "settings": {
        "foreground": "#93c5fd"
      }
    },
    {
      "name": "Language Constants (this, self, super)",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super",
        "variable.language"
      ],
      "settings": {
        "foreground": "#38bdf8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constants & Uppercase Identifiers",
      "scope": [
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#f472b6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.quoted.template"
      ],
      "settings": {
        "foreground": "#4ade80"
      }
    },
    {
      "name": "String Escapes & Regex Escapes",
      "scope": [
        "constant.character.escape",
        "string.quoted constant.character"
      ],
      "settings": {
        "foreground": "#facc15"
      }
    },
    {
      "name": "Template Literals Punctuation & Embeds",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.octal",
        "constant.numeric.binary"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "Booleans & Null Values",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language"
      ],
      "settings": {
        "foreground": "#fb923c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp",
        "string.regexp constant.character",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#f43f5e"
      }
    },
    {
      "name": "HTML & XML Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "JSX & TSX Component Tags",
      "scope": [
        "support.class.component",
        "entity.name.tag.component"
      ],
      "settings": {
        "foreground": "#2dd4bf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "HTML & XML Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx"
      ],
      "settings": {
        "foreground": "#93c5fd"
      }
    },
    {
      "name": "CSS & SCSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "CSS Selectors & IDs",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#2dd4bf"
      }
    },
    {
      "name": "CSS Values & Units",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color.w3c-standard-color-name.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "JSON Keys",
      "scope": [
        "support.type.property-name.json",
        "punctuation.support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "YAML Keys",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#38bdf8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold.markdown"
      ],
      "settings": {
        "foreground": "#f0f6fc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic.markdown"
      ],
      "settings": {
        "foreground": "#cbd5e1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.raw.inline.markdown",
        "markup.raw.block.markdown",
        "punctuation.definition.raw.markdown"
      ],
      "settings": {
        "foreground": "#4ade80"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link.markdown",
        "string.other.link.title.markdown",
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#60a5fa",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Blockquotes",
      "scope": [
        "markup.quote.markdown",
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#64748b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.parameters"
      ],
      "settings": {
        "foreground": "#94a3b8"
      }
    },
    {
      "name": "Braces & Brackets",
      "scope": [
        "punctuation.section.embedded",
        "punctuation.definition.bracket",
        "punctuation.definition.curly",
        "punctuation.definition.array"
      ],
      "settings": {
        "foreground": "#cbd5e1"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#38bdf8",
    "keyword.control": "#38bdf8",
    "storage": "#7dd3fc",
    "type": "#2dd4bf",
    "type.defaultLibrary": "#2dd4bf",
    "class": "#2dd4bf",
    "class.defaultLibrary": "#2dd4bf",
    "interface": "#2dd4bf",
